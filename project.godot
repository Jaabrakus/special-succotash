; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SOCOM-141"
run/main_scene="res://game_launcher.tscn"
config/features=PackedStringArray("4.7")

[autoload]

StudioNavigation="*res://scripts/ui/studio_navigation.gd"
TacticalOcclusionManager="*res://scripts/tactical/tactical_occlusion_manager.gd"
PlaytestStateCollector="*res://scripts/runtime/playtest_state_collector.gd"
DisplayRuntime="*res://scripts/runtime/display_runtime.gd"
PresentationSettings="*res://scripts/runtime/presentation_settings.gd"
SupabaseClient="*res://scripts/network/socom_supabase_client.gd"
ServerBootstrap="*res://scripts/server/socom_server_bootstrap.gd"
AcousticPropagation="*res://scripts/audio/acoustic_propagation_engine.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/socom_authoring/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
