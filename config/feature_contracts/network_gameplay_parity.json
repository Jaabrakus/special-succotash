      "readers": [
        "res://scripts/weapons/weapon_rig_contract.gd",
        "res://scripts/weapons/socom_weapon_controller.gd",
        "res://scripts/network/socom_multiplayer_round_loadout.gd"
      ]
    }
  ],
  "must_not_change": [
    "authored speeds and poses",
    "camera/reticle aim authority",
    "server-only damage and ammo",
    "private database credentials",
    "other worktrees and unrelated art changes"
  ],
  "proof_scripts": [
    "res://tools/network_fire_mode_parity_regression.gd",
    "res://tools/network_prediction_regression.gd",
    "res://tools/network_remote_animation_intent_regression.gd",
