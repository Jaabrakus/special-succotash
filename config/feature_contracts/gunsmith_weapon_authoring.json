      "owner": "GunsmithGizmoInteractionController",
      "source_script": "res://scripts/labs/gunsmith/gunsmith_weapon_preview_loader.gd",
      "code_symbols": ["left_grip_marker", "Socket_LeftHand", "socket_root.add_child"]
    },
    {
      "id": "left_elbow_pole",
      "type": "MeshInstance3D",
      "role": "Editable pole target controlling the support elbow bend plane.",
      "owner": "GunsmithRigAuthoringController",
      "source_script": "res://scripts/labs/gunsmith/gunsmith_rig_authoring_controller.gd",
      "code_symbols": ["left_elbow_pole_marker", "LeftElbowIKPole", "add_child"]
    },
    {
      "id": "right_elbow_pole",
      "type": "MeshInstance3D",
      "role": "Editable pole target controlling the trigger elbow bend plane.",
      "owner": "GunsmithRigAuthoringController",
      "source_script": "res://scripts/labs/gunsmith/gunsmith_rig_authoring_controller.gd",
      "code_symbols": ["right_elbow_pole_marker", "RightElbowIKPole", "add_child"]
    },
    {
      "id": "reticle_preview",
      "type": "Control",
      "role": "Displays the same weapon reticle data without becoming aim authority.",
      "owner": "GunsmithStudioView",
      "source_script": "res://scripts/labs/gunsmith/gunsmith_studio_view.gd",
      "code_symbols": ["SharedWeaponReticlePreview", "dynamic_reticle"]
    },
    {
      "id": "shared_target_pivot",
      "type": "Marker3D",
      "role": "Parents the editable shoulder, trigger-hand, support-hand, and spine presentation targets.",
      "owner": "GunsmithContactGraphController",
      "source_script": "res://scripts/labs/gunsmith/gunsmith_contact_graph_controller.gd",
      "code_symbols": ["TargetPivot", "RHUpperArmWeaponTarget", "RHWeaponTarget", "LHWeaponContactTarget", "SpineTargetWeaponAim"]
    }
  ],
  "data_contracts": [
