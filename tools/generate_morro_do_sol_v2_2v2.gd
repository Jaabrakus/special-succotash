extends SceneTree

const MapDocument := preload("res://scripts/maps/socom_map_document.gd")
const V1_PATH := "res://config/maps/painterly_coastal_village_2v2.json"
const OUTPUT_PATH := "res://config/maps/morro_do_sol_v2_2v2.json"
const COAST_TEXTURE := "res://assets/textures/environment/morro_do_sol_v2_distant_coast.png"
const PLASTER_TEXTURE := "res://assets/textures/environment/morro_do_sol_v2_painted_plaster.png"
const WOOD_TEXTURE := "res://assets/textures/environment/morro_do_sol_v2_exposed_wood.png"

const PLASTER_LIGHT := Color("b8a67f")
const PLASTER_MINT := Color("6f9d89")
const PLASTER_ROSE := Color("a85e59")
const PLASTER_OCHRE := Color("b27b38")
const WOOD_DARK := Color("4b362d")
const CABLE_DARK := Color("20262a")
const HILLSIDE_GREEN := Color("3f694e")


func _init() -> void:
	var v1 := MapDocument.load_path(V1_PATH)
	if v1.is_empty():
		push_error("Morro do Sol V2 requires the bundled V1 map: %s" % V1_PATH)
		quit(1)
		return
	var document := v1.duplicate(true)
	document["map_id"] = "morro_do_sol_v2_2v2"
	document["name"] = "Morro do Sol V2 — 2v2 Demolition"
	var environment := MapDocument.environment_from_preset("painterly_coastal_v2")
	environment["backdrop_texture"] = COAST_TEXTURE
	# The new matte has a taller cloud field. Raise its center so the painted
	# ocean horizon stays near eye level while the cloud tower clears the roofs.
	environment["backdrop_position"] = MapDocument.vector_to_data(Vector3(0.0, 22.0, 105.0))
	environment["backdrop_size"] = MapDocument.vector_to_data(Vector3(250.0, 119.3, 0.0))
	environment["backdrop_rotation"] = MapDocument.vector_to_data(Vector3.ZERO)
	document["environment"] = environment

	var objects: Array[Dictionary] = []
	for source: Dictionary in document.get("objects", []):
		var object := source.duplicate(true)
		if _is_legacy_building_piece(String(object.get("id", ""))):
			continue
		var properties: Dictionary = (object.get("properties", {}) as Dictionary).duplicate(true)
		if bool(properties.get("painterly_material", false)):
			properties["painterly_material_v2"] = true
			properties["normal_strength"] = 0.045
		object["properties"] = properties
		if String(object.get("id", "")) == "village_ground":
			object["color"] = MapDocument.color_to_data(Color("62664f"))
		objects.append(object)

	_add_building_assemblies(objects)
	_add_vertical_gameplay_layer(objects)
	_add_perimeter_landscape(objects)
	_add_unfinished_skyline(objects)
	_add_utility_layer(objects)
	_add_exterior_collapse(objects)
	document["objects"] = objects
	if not MapDocument.save_path(document, OUTPUT_PATH):
		push_error("Could not write %s" % OUTPUT_PATH)
		quit(1)
		return
	print("MORRO_DO_SOL_V2_GENERATED path=%s objects=%d details=%d" % [
		OUTPUT_PATH,
		objects.size(),
		_count_v2_details(objects),
	])
	quit(0)


func _is_legacy_building_piece(object_id: String) -> bool:
	for prefix: String in [
		"center_cafe_", "a_chapel_", "b_workshop_",
		"southwest_home_", "southeast_home_", "north_inn_",
	]:
		if object_id.begins_with(prefix):
			return true
	return false


func _add_building_assemblies(objects: Array[Dictionary]) -> void:
	# The six assemblies keep V1's footprints, floor heights, ceiling heights,
	# doors, and windows, but replace thirty-six disconnected boxes with actual
	# architectural parts generated by the canonical runtime owner.
	_add_building(
		objects, "v2_cafe_azul", "Cafe Azul", Vector3(0.0, 0.0, 3.5), Vector3(8.0, 4.4, 7.0),
		Color("6c8d99"), ["north", "south"], ["east", "west"], Color("e6d6b8"),
		Color("4f5f64"), "south", "east", 0.0, "CAFÉ AZUL"
	)
	_add_building(
		objects, "v2_community_hall", "Community Hall", Vector3(-14.0, 1.8, -4.5), Vector3(8.0, 4.8, 8.0),
		PLASTER_LIGHT, ["south", "east"], ["north", "west"], Color("75483d"),
		Color("534942"), "west", "north", 0.0, "SALÃO"
	)
	_add_building(
		objects, "v2_repair_workshop", "Repair Workshop", Vector3(14.0, 1.8, -4.5), Vector3(8.0, 4.6, 8.0),
		PLASTER_OCHRE, ["south", "west"], ["north", "east"], Color("9dc0b0"),
		Color("514840"), "east", "south", 0.0, "OFICINA", ["south", "west"]
	)
	_add_building(
		objects, "v2_rose_lane_house", "Rose Lane House", Vector3(-13.0, 0.0, 10.0), Vector3(7.0, 4.2, 5.0),
		PLASTER_ROSE, ["north"], ["south", "east"], Color("e3cfb1"),
		Color("5a4c45"), "west", "south", 0.0
	)
	_add_building(
		objects, "v2_ochre_lane_house", "Ochre Lane House", Vector3(13.0, 0.0, 10.0), Vector3(7.0, 4.2, 5.0),
		PLASTER_OCHRE, ["north"], ["south", "west"], Color("87afa1"),
		Color("584b42"), "east", "north", 0.0
	)
	_add_building(
		objects, "v2_north_gate_homes", "North Gate Homes", Vector3(0.0, 0.0, -11.5), Vector3(8.0, 4.5, 5.0),
		PLASTER_LIGHT, ["north", "south"], ["east", "west"], Color("6e8f89"),
		Color("4c4642"), "north", "west", 0.0
	)


func _add_building(
	objects: Array[Dictionary], id: String, label: String, position: Vector3, size: Vector3,
	color: Color, entries: Array[String], windows: Array[String], trim_color: Color,
	roof_color: Color, damage_side: String, downspout_side: String, parapet_height: float,
	sign_text: String = "", wood_wall_sides: Array[String] = []
) -> void:
	var object := MapDocument.make_object(&"favela_building", position, size)
	object["id"] = id
	object["name"] = label
	object["color"] = MapDocument.color_to_data(color)
	var properties: Dictionary = object.get("properties", {}).duplicate(true)
	properties.merge({
		"entries": entries,
		"windows": windows,
		"door_width": 1.55,
		"door_height": minf(2.35, size.y - 0.2),
		"window_width": 1.65,
		"window_height": 1.25,
		"trim_color": MapDocument.color_to_data(trim_color),
		"roof_color": MapDocument.color_to_data(roof_color),
		"damage_side": damage_side,
		"downspout_side": downspout_side,
		"parapet_height": parapet_height,
		"sign_text": sign_text,
		"sign_side": "south",
		"masonry_texture_path": PLASTER_TEXTURE,
		"wood_texture_path": WOOD_TEXTURE,
		"wood_wall_sides": wood_wall_sides,
		"collision_enabled": true,
		"painterly_material": true,
		"painterly_material_v2": true,
		"v2_architecture": true,
		"roughness": 1.0,
		"metallic": 0.0,
		"normal_strength": 0.025,
	}, true)
	properties.erase("texture_path")
	object["properties"] = properties
	objects.append(object)


func _add_vertical_gameplay_layer(objects: Array[Dictionary]) -> void:
	# Two mirrored switchback ramps connect the side terraces to the A and B
	# roofs. Smaller occupied modules sit on those roofs without touching the
	# retained water tanks, so the stacked silhouette is also playable.
	_add_building(
		objects, "v2_a_upper_home", "Community Hall Upper Home",
		Vector3(-12.1, 6.95, -4.5), Vector3(3.2, 3.4, 3.8),
		PLASTER_MINT, ["west"], ["north", "south"], Color("e0cfb2"),
		Color("4d4741"), "east", "north", 0.0, ""
	)
	_mark_stacked_module(objects[-1])
	_add_building(
		objects, "v2_b_upper_home", "Workshop Upper Home",
		Vector3(12.1, 6.75, -4.5), Vector3(3.2, 3.4, 3.8),
		PLASTER_ROSE, ["east"], ["north", "south"], Color("dec9aa"),
		Color("4d4741"), "west", "south", 0.0, "", ["east"]
	)
	_mark_stacked_module(objects[-1])

	_add_roof_switchback(objects, "a", -1.0, 6.95)
	_add_roof_switchback(objects, "b", 1.0, 6.75)
	_add_crate_pyramid(objects, "a", -1.0)
	_add_crate_pyramid(objects, "b", 1.0)


func _mark_stacked_module(object: Dictionary) -> void:
	var properties: Dictionary = (object.get("properties", {}) as Dictionary).duplicate(true)
	properties["v2_stacked_module"] = true
	properties["v2_vertical_route"] = true
	object["properties"] = properties


func _add_roof_switchback(objects: Array[Dictionary], side_id: String, x_sign: float, roof_top: float) -> void:
	var lower_x := x_sign * 7.0
	var landing_x := x_sign * 8.5
	var upper_x := x_sign * 10.1
	var terrace_top := 1.975
	var landing_top := 4.375
	_add_route_object(
		objects, "v2_%s_roof_ramp_lower" % side_id, &"ramp", "%s Lower Roof Ramp" % side_id.to_upper(),
		Vector3(lower_x, (terrace_top + landing_top) * 0.5, -3.5),
		Vector3(1.8, landing_top - terrace_top, 6.0), Vector3.ZERO
	)
	_add_route_object(
		objects, "v2_%s_roof_landing" % side_id, &"platform", "%s Roof Ramp Landing" % side_id.to_upper(),
		Vector3(landing_x, landing_top - 0.15, -6.65),
		Vector3(5.0, 0.30, 1.40), Vector3.ZERO
	)
	_add_route_object(
		objects, "v2_%s_roof_ramp_upper" % side_id, &"ramp", "%s Upper Roof Ramp" % side_id.to_upper(),
		Vector3(upper_x, (landing_top + roof_top) * 0.5, -3.65),
		Vector3(1.9, roof_top - landing_top, 6.0), Vector3(0.0, 180.0, 0.0)
	)
	for post_index in 2:
		var post_x := x_sign * (6.35 if post_index == 0 else 10.65)
		_add_route_object(
			objects, "v2_%s_landing_post_%d" % [side_id, post_index], &"column", "%s Landing Timber Post" % side_id.to_upper(),
			Vector3(post_x, (terrace_top + landing_top) * 0.5, -6.65),
			Vector3(0.18, landing_top - terrace_top, 0.18), Vector3.ZERO
		)


func _add_crate_pyramid(objects: Array[Dictionary], side_id: String, x_sign: float) -> void:
	var terrace_top := 1.975
	var crate_size := Vector3(1.32, 0.55, 1.32)
	var inner_x := x_sign * 7.75
	var outer_x := x_sign * 9.10
	for crate_data: Array in [
		["inner", Vector3(inner_x, terrace_top + crate_size.y * 0.5, 1.65)],
		["outer", Vector3(outer_x, terrace_top + crate_size.y * 0.5, 1.65)],
		["top", Vector3(x_sign * 8.425, terrace_top + crate_size.y * 1.5, 1.65)],
	]:
		var crate := MapDocument.make_object(&"wooden_crate", crate_data[1] as Vector3, crate_size)
		crate["id"] = "v2_%s_access_crate_%s" % [side_id, String(crate_data[0])]
		crate["name"] = "%s Roof Access Crate" % side_id.to_upper()
		crate["color"] = MapDocument.color_to_data(WOOD_DARK)
		var properties: Dictionary = crate.get("properties", {}).duplicate(true)
		properties.merge({
			"texture_path": WOOD_TEXTURE,
			"uv_scale": 0.56,
			"collision_enabled": true,
			"painterly_material": true,
			"painterly_material_v2": true,
			"v2_vertical_route": true,
		}, true)
		crate["properties"] = properties
		objects.append(crate)


func _add_route_object(
	objects: Array[Dictionary], id: String, type_name: StringName, label: String,
	position: Vector3, size: Vector3, rotation: Vector3
) -> void:
	var object := MapDocument.make_object(type_name, position, size)
	object["id"] = id
	object["name"] = label
	object["rotation_degrees"] = MapDocument.vector_to_data(rotation)
	object["color"] = MapDocument.color_to_data(WOOD_DARK)
	var properties: Dictionary = object.get("properties", {}).duplicate(true)
	properties.merge({
		"texture_path": WOOD_TEXTURE,
		"surface_kind": "default",
		"uv_scale": 0.48,
		"texture_tint_weight": 0.05,
		"texture_multiplier": MapDocument.color_to_data(Color("9b8e7b")),
		"collision_enabled": true,
		"painterly_material": true,
		"painterly_material_v2": true,
		"v2_vertical_route": true,
	}, true)
	object["properties"] = properties
	objects.append(object)


func _add_perimeter_landscape(objects: Array[Dictionary]) -> void:
	for data: Array in [
		["west_hillside", Vector3(-31.5, -3.2, -1.0), Vector3(18.0, 13.5, 34.0), 801],
		["east_hillside", Vector3(31.5, -3.0, -3.0), Vector3(18.0, 12.5, 32.0), 802],
		["north_hillside", Vector3(0.0, -3.8, -31.0), Vector3(45.0, 12.0, 18.0), 803],
	]:
		_add_detail(
			objects, String(data[0]), &"rocky_mountain", "Painted Perimeter Hillside",
			data[1] as Vector3, data[2] as Vector3, HILLSIDE_GREEN, "terrain", "",
			Vector3.ZERO, {"ridge_segments": 18, "roughness_amount": 0.26, "variation_seed": int(data[3]), "surface_kind": "rock"}
		)
	for index in 12:
		var west_side := index % 2 == 0
		var side_x := -23.0 if west_side else 23.0
		var z := -15.0 + float(index / 2) * 5.8
		_add_detail(
			objects, "v2_edge_bush_%02d" % index, &"bush", "Painted Edge Vegetation",
			Vector3(side_x + (-0.5 if west_side else 0.5), -0.1, z),
			Vector3(3.4, 2.2 + float(index % 3) * 0.25, 2.8),
			Color("3f7247"), "vegetation", "", Vector3.ZERO,
			{"cluster_count": 7, "variation_seed": 900 + index, "concealment": false}
		)
	for tree_data: Array in [
		["v2_tree_west_s", Vector3(-24.5, 0.0, 12.0), 921],
		["v2_tree_west_n", Vector3(-24.0, 0.0, -12.0), 922],
		["v2_tree_east_s", Vector3(24.5, 0.0, 11.0), 923],
		["v2_tree_east_n", Vector3(24.0, 0.0, -13.0), 924],
	]:
		_add_detail(
			objects, String(tree_data[0]), &"tree", "Boundary Canopy",
			tree_data[1] as Vector3, Vector3(4.0, 8.5, 4.0), Color("315f3f"),
			"vegetation", "", Vector3.ZERO,
			{"canopy_layers": 5, "trunk_ratio": 0.38, "variation_seed": int(tree_data[2])}
		)


func _add_unfinished_skyline(objects: Array[Dictionary]) -> void:
	# This exposed frame is above the defender-side homes. It creates the V2
	# silhouette without adding a reachable power position or fake collision.
	for x in [-3.2, 0.0, 3.2]:
		for z in [-13.35, -9.65]:
			_add_detail(objects, "v2_frame_post_%s_%s" % [str(x), str(z)], &"primitive_box", "Unfinished Roof Post", Vector3(x, 6.35, z), Vector3(0.22, 3.2, 0.22), WOOD_DARK, "frame", WOOD_TEXTURE)
	for z in [-13.35, -9.65]:
		_add_detail(objects, "v2_frame_cross_%s" % str(z), &"primitive_box", "Unfinished Cross Beam", Vector3(0.0, 7.92, z), Vector3(6.65, 0.24, 0.24), WOOD_DARK, "frame", WOOD_TEXTURE)
	for x in [-3.2, 0.0, 3.2]:
		_add_detail(objects, "v2_frame_depth_%s" % str(x), &"primitive_box", "Unfinished Depth Beam", Vector3(x, 7.92, -11.5), Vector3(0.24, 0.24, 3.95), WOOD_DARK, "frame", WOOD_TEXTURE)
	_add_detail(objects, "v2_frame_brace_left", &"primitive_box", "Left Roof Brace", Vector3(-1.55, 6.75, -13.35), Vector3(3.5, 0.20, 0.20), WOOD_DARK, "frame", WOOD_TEXTURE, Vector3(0.0, 0.0, 43.0))
	_add_detail(objects, "v2_frame_brace_right", &"primitive_box", "Right Roof Brace", Vector3(1.55, 6.75, -13.35), Vector3(3.5, 0.20, 0.20), WOOD_DARK, "frame", WOOD_TEXTURE, Vector3(0.0, 0.0, -43.0))


func _add_utility_layer(objects: Array[Dictionary]) -> void:
	for pole_data: Array in [
		["west_s", Vector3(-19.2, 3.8, 10.0)], ["east_s", Vector3(19.2, 3.8, 10.0)],
		["west_m", Vector3(-19.2, 3.8, 3.0)], ["east_m", Vector3(19.2, 3.8, 3.0)],
		["west_n", Vector3(-19.2, 3.8, -11.0)], ["east_n", Vector3(19.2, 3.8, -11.0)],
	]:
		_add_detail(
			objects, "v2_pole_%s" % String(pole_data[0]), &"utility_pole", "Timber Utility Pole Assembly",
			pole_data[1] as Vector3, Vector3(0.24, 7.6, 0.24), WOOD_DARK, "utility_pole", "",
			Vector3.ZERO, {"crossbar_width": 1.45}
		)
	for wire_data: Array in [
		["south_a", 10.0, 7.25], ["south_b", 8.9, 7.40],
		["market", 3.0, 7.30], ["north", -11.0, 7.40],
	]:
		_add_sagging_wire(objects, String(wire_data[0]), float(wire_data[1]), float(wire_data[2]))


func _add_sagging_wire(objects: Array[Dictionary], id: String, z: float, edge_y: float) -> void:
	var points: Array[Vector3] = [
		Vector3(-19.2, edge_y, z),
		Vector3(-6.4, edge_y - 0.48, z),
		Vector3(6.4, edge_y - 0.58, z),
		Vector3(19.2, edge_y, z),
	]
	var point_data: Array[Dictionary] = []
	for point: Vector3 in points:
		point_data.append(MapDocument.vector_to_data(point))
	_add_detail(
		objects, "v2_wire_%s" % id, &"cable_curve", "Sagging Utility Cable",
		Vector3.ZERO, Vector3(38.4, 0.04, 0.04), CABLE_DARK, "cable", "", Vector3.ZERO,
		{"points": point_data, "radius": 0.010, "segment_count": 18}
	)


func _add_exterior_collapse(objects: Array[Dictionary]) -> void:
	# The collapse is beyond the south retaining wall. It enriches the exterior
	# view without becoming ambiguous cover or a traversal route.
	_add_detail(objects, "v2_collapse_wall_left", &"jagged_wall", "Exterior Collapsed Wall", Vector3(-12.5, 2.4, 20.2), Vector3(6.0, 4.8, 0.35), PLASTER_ROSE, "collapse", "", Vector3(0.0, -12.0, 0.0))
	_add_detail(objects, "v2_collapse_wall_right", &"jagged_wall", "Exterior Collapsed Wall", Vector3(-7.2, 1.9, 20.8), Vector3(5.0, 3.8, 0.35), PLASTER_MINT, "collapse", "", Vector3(0.0, 16.0, 0.0))
	for beam_data: Array in [
		["a", Vector3(-11.5, 3.3, 19.4), Vector3(5.6, 0.22, 0.22), Vector3(0.0, 8.0, 24.0)],
		["b", Vector3(-9.0, 2.3, 19.8), Vector3(5.0, 0.24, 0.24), Vector3(0.0, -12.0, -18.0)],
		["c", Vector3(-13.0, 1.2, 20.0), Vector3(3.8, 0.22, 0.22), Vector3(0.0, 18.0, -11.0)],
		["d", Vector3(-7.5, 3.8, 20.5), Vector3(4.2, 0.20, 0.20), Vector3(0.0, -8.0, 31.0)],
	]:
		_add_detail(objects, "v2_collapse_beam_%s" % String(beam_data[0]), &"primitive_box", "Collapsed Timber", beam_data[1] as Vector3, beam_data[2] as Vector3, WOOD_DARK, "collapse", WOOD_TEXTURE, beam_data[3] as Vector3)
	for rubble_data: Array in [
		["a", Vector3(-12.6, 0.45, 19.1), Vector3(1.4, 0.8, 1.0), PLASTER_LIGHT],
		["b", Vector3(-10.2, 0.35, 19.8), Vector3(1.1, 0.7, 1.4), PLASTER_ROSE],
		["c", Vector3(-7.8, 0.40, 19.5), Vector3(1.5, 0.75, 0.9), PLASTER_MINT],
	]:
		_add_detail(objects, "v2_rubble_%s" % String(rubble_data[0]), &"primitive_box", "Painted Rubble", rubble_data[1] as Vector3, rubble_data[2] as Vector3, rubble_data[3] as Color, "collapse", "", Vector3(8.0, 17.0, 12.0))


func _add_detail(
	objects: Array[Dictionary], id: String, type_name: StringName, label: String,
	position: Vector3, size: Vector3, color: Color, detail_kind: String,
	texture_path: String = "", rotation: Vector3 = Vector3.ZERO,
	extra_properties: Dictionary = {}
) -> void:
	var object := MapDocument.make_object(type_name, position, size)
	object["id"] = id
	object["name"] = label
	object["rotation_degrees"] = MapDocument.vector_to_data(rotation)
	object["color"] = MapDocument.color_to_data(color)
	var properties: Dictionary = object.get("properties", {}).duplicate(true)
	properties.merge({
		"v2_detail": true,
		"v2_detail_kind": detail_kind,
		"collision_enabled": false,
		"painterly_material": true,
		"painterly_material_v2": true,
		"roughness": 0.98,
		"metallic": 0.0,
		"normal_strength": 0.035,
	}, true)
	if not texture_path.is_empty():
		properties["texture_path"] = texture_path
		properties["surface_kind"] = "default"
		properties["uv_scale"] = 0.58
	properties.merge(extra_properties, true)
	object["properties"] = properties
	objects.append(object)


func _count_v2_details(objects: Array[Dictionary]) -> int:
	var count := 0
	for object: Dictionary in objects:
		if bool((object.get("properties", {}) as Dictionary).get("v2_detail", false)):
			count += 1
	return count
